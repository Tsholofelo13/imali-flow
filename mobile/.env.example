# Android emulator: http://10.0.2.2:8080
# Real phone on the same Wi-Fi: http://<your-PC-LAN-IP>:8080
# Release APK: use the https hosted URL (Android blocks plain http in release builds)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Judges' demo account. Fill in locally. Keep .env out of git.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
