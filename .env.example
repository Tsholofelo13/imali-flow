# Copy to .env and fill in. NEVER commit .env
POSTGRES_DB=imali
POSTGRES_USER=imali
POSTGRES_PASSWORD=change_me_locally
# At least 32 characters
JWT_SECRET=change_me_to_a_long_random_string_of_32plus_chars
JWT_TTL_MINUTES=30
# Shared secret between backend and ai-service (internal only)
AI_INTERNAL_KEY=change_me_internal_key
# LLM provider key (stays on the server, never in the mobile app)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
